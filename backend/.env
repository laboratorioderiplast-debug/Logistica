# --- Connessione al SQL Server di ARCA Evolution ---
ARCA_DRIVER={SQL Server}
ARCA_SERVER=svrgestionale
ARCA_DATABASE=ADB_DERIPLAST
ARCA_TRUSTED_CONNECTION=yes
ARCA_USER=
ARCA_PASSWORD=
# In alternativa, se il PC dove gira il backend e' nel dominio e
# ARCA usa autenticazione Windows, imposta ARCA_TRUSTED_CONNECTION=yes
# e lascia ARCA_USER/ARCA_PASSWORD vuoti.


# --- Database locale dell'app (stato LP in lavorazione) ---
APP_DB_PATH=./app_state.db

# --- Polling nuovi LP da ARCA (secondi) ---
POLL_INTERVAL_SECONDS=10

# --- Sicurezza minimale (da rafforzare prima di andare in produzione) ---
APP_SHARED_TOKEN=cambia_questo_token
STORICO_LP_GIORNI=30